datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Defines the authorization level of a user inside a project workspace.
enum Role {
  /// Project Admins have full administrative authority over the project, 
  /// including managing members, generating join codes, and promoting others.
  ADMIN_PROJECT
  /// Members can perform normal testing operations, execute runs, 
  /// and draft test cases, but cannot edit workspace access or roles.
  MEMBER
}

/// Represents the review state of a test case inside the repository.
enum CaseStatus {
  /// Test cases start as DRAFT and are locked from being added to any Test Run.
  DRAFT
  /// Test cases transition to READY once verified by a human, making them eligible for curation.
  READY
}

/// Represents the operational state of a Test Run.
enum RunStatus {
  /// Initial state where cases are being curated into the Test Run.
  DRAFT
  /// Active testing phase allowing manual feedback.
  IN_PROGRESS
  /// Automation execution is active. Manual inputs are locked out across screens via WebSockets.
  AUTOMATION_RUNNING
  /// Official closure of the release quality gate.
  DONE
}

/// The status of a specific test case inside an active Test Run.
enum ExecutionStatus {
  /// Test case is pending execution.
  TO_DO
  /// Test case has passed validation.
  PASSED
  /// Test case has failed. May trigger auto-retry or AI self-healing.
  FAILED
}

/// User accounts system representing engineers, leads, and stakeholders.
/// Integrates credentials and rate-limiting properties for brute-force OTP protection.
model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  name          String
  /// Number of consecutive failed validation attempts for brute-force OTP protection.
  attempts      Int             @default(0)
  /// Account lockout timestamp. If populated and in the future, the user is locked out.
  disabledUntil DateTime?
  createdAt     DateTime        @default(now())
  
  /// Junction relationship mapping this user to their respective projects.
  projects      ProjectMember[]
  /// Test cases authored by this user. Backed by onDelete: SetNull for data retention.
  testCases     TestCase[]
}

/// Multi-tenant boundary representing a single self-contained test "warehouse".
model Project {
  id          String              @id @default(uuid())
  name        String
  createdAt   DateTime            @default(now())
  
  /// Active members assigned to this project.
  members     ProjectMember[]
  /// Invitations sent out to invite new members to this project.
  invitations ProjectInvitation[]
  /// Test cases stored within this project's repository.
  testCases   TestCase[]
  /// Test runs scheduled or executed within this project.
  testRuns    TestRun[]
}

/// Junction table facilitating many-to-many relationship between Users and Projects.
/// Enforces multi-tenancy isolation.
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @default(MEMBER)

  /// A user can have exactly one membership association per project.
  @@unique([projectId, userId])
}

/// Tracks invitations generated by Project Admins.
/// Employs unique Join Codes with enforced expiration times (3 hours) for collaboration security.
model ProjectInvitation {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Target email address this invitation is intended for.
  email     String
  /// Unique alphanumeric code shared to join the project workspace.
  joinCode  String   @unique
  /// Tracks if the Join Code has already been redeemed.
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  /// Expiration timestamp, typically set to 3 hours from creation.
  expiredAt DateTime
}

/// Individual test cases within the project's repository.
model TestCase {
  id             String          @id @default(uuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  /// JSON payload representing sequential test steps or parameters.
  steps          Json
  /// Indicator of whether this test case has a matching automation script.
  hasAutomation  Boolean         @default(false)
  status         CaseStatus      @default(DRAFT)
  
  /// Creator's unique identifier.
  createdById    String?
  /// Author association. Decoupled using SetNull so the test case is retained even if the author is deleted.
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  
  /// Execution items in various test runs referencing this test case.
  testRunItems   TestRunItem[]

  /// Compound index to optimize repository filtering.
  @@index([projectId, status])
}

/// A curated scope of test cases prepared for manual and/or automated execution.
model TestRun {
  id          String        @id @default(uuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  status      RunStatus     @default(DRAFT)
  createdAt   DateTime      @default(now())
  
  /// Set of test cases included in this execution run.
  items       TestRunItem[]
}

/// Junction table mapping a test case to a specific Test Run, containing individual execution state.
model TestRunItem {
  id              String          @id @default(uuid())
  testRunId       String
  testRun         TestRun         @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCaseId      String
  testCase        TestCase        @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executionStatus ExecutionStatus @default(TO_DO)
  /// Number of retries executed for this script to combat flakiness.
  retryCount      Int             @default(0)
  /// Remarks, failure descriptions, or observations logged during execution.
  notes           String?
  updatedAt       DateTime        @updatedAt

  /// Ensure a test case is added at most once to a single test run.
  @@unique([testRunId, testCaseId])
}
